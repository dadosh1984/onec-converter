#!/bin/sh
# pre-commit hook: блокирует коммит чувствительных артефактов (Фаза 39).
# Установка:  git config core.hooksPath .githooks
# Запрещено:  (1) настоящие файлы баз (*.1CD > 50 МБ);
#             (2) промежуточные дампы extract/load (*.json) и ПДн-журналы;
# Использование намеренное — снять флаг, добавив имя в exceptions ниже.

BLOCK_EXTS=".1CD"
BLOCK_NAMES="extract.json load.json transformed.json"
BLOCK_SUFFIX=".jsonl"

exceptions=""

blocked=0

for f in $(git diff --cached --name-only); do
    base=$(basename "$f")
    skip=0
    for e in $exceptions; do
        [ "$base" = "$e" ] && skip=1
    done
    [ $skip -eq 1 ] && continue

    case "$base" in
        *.1CD)
            size=$(git show ":$f" 2>/dev/null | wc -c)
            if [ "$size" -gt 52428800 ]; then
                echo "блокировка: $f — файл базы 1CD (${size} б) в коммите. Используйте clone-db/внешний стор." >&2
                blocked=1
            fi
            ;;
        extract.json|load.json|transformed.json)
            echo "блокировка: $f — дамп данных (возможно ПДн) в коммите." >&2
            blocked=1
            ;;
        *.jsonl)
            echo "блокировка: $f — журнал/дамп может содержать ПДн." >&2
            blocked=1
            ;;
    esac
done

[ $blocked -ne 0 ] && echo "Коммит отменён pre-commit hook'ом (Фаза 39)." >&2 && exit 1

# U31 (Фаза 52): сканер секретов в диффе коммита. Изменения больших
# файлов игнорируются (шум), ключи/пароли/токены в коде блокируют коммит.
secret_pat='(AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16})|(--BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY--)|(password\s*[=:]\s*.{6,})|(client_secret\s*[=:])|(secret_key\s*[=:])'
# видимый текст diff (без бинарных) для первых добавленных строк
if git show --cached --no-renames --format= -- . 2>/dev/null | \
    grep -nE "$secret_pat" | head -5; then
    echo "блокировка: в диффе коммита найден вероятный секрет (ключ/пароль). " >&2
    echo "Уберите секрет или замаскируйте через env/переменные конфига." >&2
    echo "Коммит отменён pre-commit hook'ом (U31, Фаза 52)." >&2
    exit 1
fi
exit 0
