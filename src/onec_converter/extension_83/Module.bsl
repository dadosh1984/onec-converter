// Модуль HTTP-сервиса "onec_loader" (вставляется в 1С:Предприятие).
// Код-референс: пользователь вставляет в Конфигуратор и перезаписывает
// соответствующие процедуры.
//
// Фаза 18 (безопасность): аутентификация X-API-Key; транзакция + Попытка/
// Исключение на объект (частичный отчёт errors); валидация реквизитов.
// Фаза 19 (горизонт данных): расспознание Справочник.* и Документ.*;
// обработка флага replace (поиск по коду + обновление, Обновлено>0).

// Shared secret для аутентификации. Заполните своим значением.
ОжидаемыйКлюч = "CHANGE-ME-AND-KEEP-SECRET";

// Фаза 22 (безопасность): OAuth2/JWT. Ожидаемый issuer токена и алгоритм.
ОжидаемыйIssuer = "onec-converter";
ОжидаемыйАлгоритм = "HS256";

// Фаза 52 (U30): ротация ключей JWT. Список структур kid -> секрет.
// Текущий ключ + предыдущие позволяют плавную ротацию без сбоев авторизации.
// kid из заголовка токена выбирает секрет жёстко; токены без kid (старые)
// проверяются всеми секретами (обратная совместимость).
НаборСекретовJWT = Новый Массив;
НаборСекретовJWT.Добавить(Новый Структура("kid, secret", "current", ОжидаемыйКлюч));
// Для ротации добавьте старый ключ:
// НаборСекретовJWT.Добавить(Новый Структура("kid, secret", "prev-2025", "ПРЕДЫДУЩИЙ_СЕКРЕТ"));

// Фаза 45 (rate-limit): счётчик последовательных неудачных попыток ключа.
// Простая защита от перебора в рамках сессии сервиса; для production
// используйте внешний rate-limiter (nginx/шлюз) — переменные модуля
// HTTP-сервиса 1С не гарантируют хранение между запросами.
Перем СчётчикНеудач;

Функция ПроверитьКлюч(Запрос)
    // временная блокировка после N неудач (Фаза 45)
    Если СчётчикНеудач >= 5 Тогда
        Возврат Ложь;
    КонецЕсли;
    Заголовок = Запрос.Заголовки.Получить("x-api-key");
    Если НЕ ПустаяСтрока(Заголовок) И Совпадает(Заголовок, ОжидаемыйКлюч) Тогда
        СчётчикНеудач = 0;
        Возврат Истина;
    КонецЕсли;
    // иначе — пробуем Bearer-JWT (дополняет shared-secret)
    Если ПроверитьТокен(Запрос) Тогда
        СчётчикНеудач = 0;
        Возврат Истина;
    КонецЕсли;
    СчётчикНеудач = СчётчикНеудач + 1;
    Возврат Ложь;
КонецФункции

// Постоянное по времени (constant-time) сравнение строк — исключает
// timing-атаку на X-API-Key по аналогии с проверкой HMAC-подписи.
Функция Совпадает(А, Б)
    Если СтрДлина(А) <> СтрДлина(Б) Тогда
        Возврат Ложь;
    КонецЕсли;
    Р = 0;
    Для И = 1 По СтрДлина(А) Цикл
        Р = Р ПобитовыйИли ИсключающееИли(КодСимвола(А, И), КодСимвола(Б, И));
    КонецЦикла;
    Возврат Р = 0;
КонецФункции

// --- JWT (HS256) ---
Функция ПроверитьТокен(Запрос)
    Заголовок = Запрос.Заголовки.Получить("authorization");
    Если ПустаяСтрока(Заголовок) Тогда
        Возврат Ложь;
    КонецЕсли;
    Слова = СтрРазделить(Заголовок, " ");
    Если Слова.Количество() <> 2 ИЛИ НизкийРегистр(Слова[0]) <> "bearer" Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат ПроверитьJWT(Слова[1]);
КонецФункции

Функция ПроверитьJWT(Токен)
    Попытка
        Части = СтрРазделить(Токен, ".");
        Если Части.Количество() <> 3 Тогда
            Возврат Ложь;
        КонецЕсли;
        Заголовок = ЧитатьJSONИзСтроки(ДекодироватьBase64URL(Части[0]));
        ПолезнаяНагрузка = ЧитатьJSONИзСтроки(ДекодироватьBase64URL(Части[1]));
        Если Заголовок = Неопределено ИЛИ ПолезнаяНагрузка = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
        Если Заголовок.Получить("alg") <> ОжидаемыйАлгоритм Тогда
            Возврат Ложь;
        КонецЕсли;
        Если НЕ ПолезнаяНагрузка.Свойство("exp")
                ИЛИ НЕ ПолезнаяНагрузка.Свойство("iss") Тогда
            Возврат Ложь;
        КонецЕсли;
        ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000;
        Если ТекущееВремя > Число(ПолезнаяНагрузка.Получить("exp")) Тогда
            Возврат Ложь;
        КонецЕсли;
        Если ПолезнаяНагрузка.Получить("iss") <> ОжидаемыйIssuer Тогда
            Возврат Ложь;
        КонецЕсли;
        Подпись = ДекодироватьBase64URL(Части[2]);

        // Ротация ключей (U30): kid из заголовка выбирает секрет жёстко;
        // без kid — пробуем все (обратная совместимость со старыми токенами).
        УказанныйКид = Заголовок.Получить("kid");
        Для Каждого Пара Из НаборСекретовJWT Цикл
            Если НЕ ПустаяСтрока(УказанныйКид) И Пара.kid <> УказанныйКид Тогда
                Продолжить;
            КонецЕсли;
            ОжидаемаяПодпись = HMACSHA256(Пара.secret, Части[0] + "." + Части[1]);
            Если БезопасноеСравнение(Подпись, ОжидаемаяПодпись) Тогда
                Возврат Истина;
            КонецЕсли;
        КонецЦикла;
        Возврат Ложь;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция ЧитатьJSONИзСтроки(Данные)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Данные));
    Результат = Чтение.Прочитать();
    Чтение.Закрыть();
    Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ДекодироватьBase64URL(СтрокаURL)
    СтрокаBase64 = СтрЗаменить(СтрЗаменить(СтрокаURL, "-", "+"), "_", "/");
    Пока СтрДлина(СтрокаBase64) % 4 <> 0 Цикл
        СтрокаBase64 = СтрокаBase64 + "=";
    КонецЦикла;
    Возврат Base64Значение(СтрокаBase64);
КонецФункции

Функция ХешSHA256(Данные)
    Хеш = Новый ХешОбъект(ХешФункция.SHA256);
    Хеш.Добавить(Данные);
    Возврат Хеш.ПолучитьХеш();
КонецФункции

// HMAC-SHA256 без внешних библиотек (1С не имеет встроенного HMAC).
Функция HMACSHA256(Секрет, Сообщение)
    РазмерБлока = 64;
    Ключ = ПолучитьДвоичныеДанныеИзСтроки(Секрет, КодировкаТекста.UTF8);
    Если Ключ.Размер() > РазмерБлока Тогда
        Ключ = ХешSHA256(Ключ);
    КонецЕсли;
    БуферКлюча = Новый БуферДвоичныхДанных(РазмерБлока);
    БуферКлюча.Записать(0, Ключ);
    БуферИпад = Новый БуферДвоичныхДанных(РазмерБлока);
    БуферОпад = Новый БуферДвоичныхДанных(РазмерБлока);
    Для Инд = 0 По РазмерБлока - 1 Цикл
        БуферИпад.УстановитьБайт(Инд,
            ПобитовыйИсключительноеИЛИ(БуферКлюча.ПолучитьБайт(Инд), 0x36));
        БуферОпад.УстановитьБайт(Инд,
            ПобитовыйИсключительноеИЛИ(БуферКлюча.ПолучитьБайт(Инд), 0x5C));
    КонецЦикла;
    ВнутреннийХеш = ХешSHA256(БуферИпад.ПолучитьДвоичныеДанные()
        + ПолучитьДвоичныеДанныеИзСтроки(Сообщение, КодировкаТекста.UTF8));
    Возврат ХешSHA256(БуферОпад.ПолучитьДвоичныеДанные() + ВнутреннийХеш);
КонецФункции

Функция БезопасноеСравнение(Данные1, Данные2)
    Если Данные1.Размер() <> Данные2.Размер() Тогда
        Возврат Ложь;
    КонецЕсли;
    Буфер1 = Данные1.ПолучитьБуферДвоичныхДанных();
    Буфер2 = Данные2.ПолучитьБуферДвоичныхДанных();
    Отличия = 0;
    Для Инд = 0 По Данные1.Размер() - 1 Цикл
        Отличия = Отличия
            + ПобитовыйИсключительноеИЛИ(Буфер1.ПолучитьБайт(Инд),
                                          Буфер2.ПолучитьБайт(Инд));
    КонецЦикла;
    Возврат Отличия = 0;
КонецФункции

// POST /load — обработчик записи данных в приёмник.
Функция ЗаписьДанных(Запрос) Экспорт
    Если НЕ ПроверитьКлюч(Запрос) Тогда
        Ответ401 = Новый HTTPСервисОтвет(401);
        Ответ401.УстановитьТелоИзСтроки("unauthorized", "text/plain; charset=utf-8");
        Возврат Ответ401;
    КонецЕсли;

    Тело = Запрос.ПолучитьТелоКакСтроку();
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Тело);
    Пакет = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();

    // Лимит пакета (U32): защита от гигантских тел запросов/переполнения памяти.
    ЛимитПакета = 1000;
    Если Пакет.objects.Количество() > ЛимитПакета Тогда
        Ответ429 = Новый HTTPСервисОтвет(413);
        Ответ429.УстановитьТелоИзСтроки(
            "слишком много объектов в пакете (макс. " + ЛимитПакета + ")",
            "text/plain; charset=utf-8");
        Возврат Ответ429;
    КонецЕсли;

    // Idempotency-Key (U29): один и тот же объект в пределах пакета
    // (key совпадает) записывается только один раз — повторные пропускаются.
    // Ограничение: Перем не гарантирует хранение между запросами HTTP-сервиса,
    // поэтому идемпотентность действует в пределах одного поступившего пакета
    // (межзапросной дубль ведёт на стороне клиента через audit/verify).
    ОбработанныеКлючи = Новый Массив;

    ВариантЗамены = Пакет.replace = Истина; // обновлять существующие
    Создано = 0; Обновлено = 0; Ошибки = Новый Массив;
    Для Каждого Описание Из Пакет.objects Цикл
        ИдемпотентностьКлюч = "";
        Если ТипЗнч(Описание) = Тип("Структура") И Описание.Свойство("idem") Тогда
            ИдемпотентностьКлюч = Строка(Описание.idem);
        КонецЕсли;
        Если НЕ ПустаяСтрока(ИдемпотентностьКлюч) И ОбработанныеКлючи.Найти(ИдемпотентностьКлюч) <> Неопределено Тогда
            Продолжить; // повторный объект с тем же idem в пакете — пропустить
        КонецЕсли;
        Попытка
            НачатьТранзакцию();
            ТипОбъекта = Описание.type; // "Справочник.X" | "Документ.Y"
            ЭтоСправочник = Ложь; ЭтоДокумент = Ложь; Имя = ТипОбъекта;
            Если СтрНачинаетсяС(ТипОбъекта, "Справочник.") Тогда
                ЭтоСправочник = Истина; Имя = СтрЗаменить(ТипОбъекта, "Справочник.", "");
            ИначеЕсли СтрНачинаетсяС(ТипОбъекта, "Документ.") Тогда
                ЭтоДокумент = Истина; Имя = СтрЗаменить(ТипОбъекта, "Документ.", "");
            Иначе
                ВызватьИсключение("Неподдерживаемый тип: " + ТипОбъекта);
            КонецЕсли;

            Ключ = "";
            Наименование = "";
            Если ЭтоСправочник Тогда
                Если Метаданные.Справочники.Найти(Имя) = Неопределено Тогда
                    ВызватьИсключение("Нет справочника: " + Имя);
                КонецЕсли;
            ИначеЕсли ЭтоДокумент Тогда
                Если Метаданные.Документы.Найти(Имя) = Неопределено Тогда
                    ВызватьИсключение("Нет документа: " + Имя);
                КонецЕсли;
            КонецЕсли;

            // извлекаем код/номер и наименование из attributes для поиска
            УжеОбъект = Неопределено; Найден = Ложь;
            Если ВариантЗамены Тогда
                Если ЭтоСправочник Тогда
                    Ключ = Описание.attributes["Код"];
                    Наименование = Описание.attributes["Наименование"];
                Иначе
                    Ключ = String(Описание.attributes["Номер"]);
                КонецЕсли;
                УжеОбъектНайдено = НайтиОбъект2(ЭтоСправочник, Имя, Ключ, Наименование);
                УжеОбъект = УжеОбъектНайдено[0]; Найден = УжеОбъектНайдено[1];
            КонецЕсли;

            Если Найден Тогда
                Объект = УжеОбъект;
            ИначеЕсли ЭтоСправочник Тогда
                Объект = Справочники[Имя].СоздатьОбъект();
            Иначе
                Объект = Документы[Имя].СоздатьДокумент();
            КонецЕсли;

            Для Каждого КВ Из Описание.attributes Цикл
                ИмяРеквизита = Строка(КВ.Ключ);
                // Только существующие реквизиты; для документа служебные (Номер/Дата) тоже.
                Если ЭтоСправочник
                    И Метаданные.Справочники[Имя].Реквизиты.Найти(ИмяРеквизита) = Неопределено
                    И НЕ ИмяРеквизита = "Наименование" Тогда
                    ВызватьИсключение("Нет реквизита: " + ИмяРеквизита);
                КонецЕсли;
                Объект[ИмяРеквизита] = КВ.Значение;
            КонецЦикла;
            Объект.Записать();
            ЗафиксироватьТранзакцию();
            Если НЕ ПустаяСтрока(ИдемпотентностьКлюч) Тогда
                ОбработанныеКлючи.Добавить(ИдемпотентностьКлюч);
            КонецЕсли;
            Если Найден Тогда
                Обновлено = Обновлено + 1;
            Иначе
                Создано = Создано + 1;
            КонецЕсли;
        Исключение
            Если ТранзакцияАктивна() Тогда
                ОтменитьТранзакцию();
            КонецЕсли;
            Ошибки.Добавить(ТипОбъекта + ": " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    Ответ = Новый HTTPСервисОтвет(200);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись,
        Новый Структура("ok,created,updated,errors", Истина, Создано, Обновлено, Ошибки));
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции

// Упрощённый поиск: возвращает [Объект, Найден].
Функция НайтиОбъект2(ЭтоСправочник, Имя, Ключ, Наименование)
    // Нормализация перед поиском: убираем лишние пробелы (не создаём дубли
    // из-за «Иван » / «иван»), регистр оставляем пользователю (поиск по коду
    // и наименованию в 1С обычно регистронезависим).
    НормКлюч = СокрЛП(Ключ);
    НормНаименование = СокрЛП(Наименование);
    Если ЭтоСправочник Тогда
        Если НЕ ПустаяСтрока(НормКлюч) Тогда
            Найден = Справочники[Имя].НайтиПоКоду(НормКлюч);
            Если НЕ Найден.Пустая() Тогда
                Возврат Новый Массив(2, Найден, Истина);
            КонецЕсли;
        КонецЕсли;
        Если НЕ ПустаяСтрока(НормНаименование) Тогда
            Найден = Справочники[Имя].НайтиПоНаименованию(НормНаименование);
            Если НЕ Найден.Пустая() Тогда
                Возврат Новый Массив(2, Найден, Истина);
            КонецЕсли;
        КонецЕсли;
    Иначе
        Если НЕ ПустаяСтрока(НормКлюч) Тогда
            Найден = Документы[Имя].НайтиПоНомеру(НормКлюч);
            Если НЕ Найден.Пустая() Тогда
                Возврат Новый Массив(2, Найден, Истина);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Возврат Новый Массив(2, Неопределено, Ложь);
КонецФункции

Функция МетаданныеИБ(Запрос) Экспорт
    // GET /metadata — описание структуры приёмника (справочники, документы)
    Если НЕ ПроверитьКлюч(Запрос) Тогда
        Ответ401 = Новый HTTPСервисОтвет(401);
        Ответ401.УстановитьТелоИзСтроки("unauthorized", "text/plain; charset=utf-8");
        Возврат Ответ401;
    КонецЕсли;

    СтруктураОтвета = Новый Структура;
    Справочники = Новый Массив;
    Для Каждого Спр Из Метаданные.Справочники Цикл
        Реквизиты = Новый Массив;
        Для Каждого Рек Из Спр.Реквизиты Цикл
            Реквизиты.Добавить(Новый Структура("Имя,Тип", Рек.Имя, Строка(Рек.Тип)));
        КонецЦикла;
        Справочники.Добавить(Новый Структура("Имя,Синоним,Реквизиты", Спр.Имя, Спр.Синоним, Реквизиты));
    КонецЦикла;
    Документы = Новый Массив;
    Для Каждого Док Из Метаданные.Документы Цикл
        Документы.Добавить(Новый Структура("Имя,Синоним", Док.Имя, Док.Синоним));
    КонецЦикла;
    СтруктураОтвета.Вставить("Справочники", Справочники);
    СтруктураОтвета.Вставить("Документы", Документы);
    Ответ = Новый HTTPСервисОтвет(200);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, СтруктураОтвета);
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции
