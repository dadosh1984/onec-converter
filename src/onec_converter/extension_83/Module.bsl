// Модуль HTTP-сервиса "onec_loader" (вставляется в 1С:Предприятие).
// Код-референс: пользователь вставляет в Конфигуратор и перезаписывает
// соответствующие процедуры. Полная XML-выгрузка расширения формируется
// штатным механизмом 1С:Предприятие после сборки.
//
// Фаза 18 (безопасность):
// - аутентификация: обязательный заголовок X-API-Key равный ОжидаемыйКлюч;
// - транзакция + Попытка/Исключение вокруг каждого объекта: один битый
//   объект не роняет весь пакет — его ошибка попадает в errors (частичный
//   отчёт), остальные объекты пишутся.

// Shared secret для аутентификации. Заполните своим значением.
ОжидаемыйКлюч = "CHANGE-ME-AND-KEEP-SECRET";

Функция ПроверитьКлюч(Запрос)
    Заголовок = Запрос.Заголовки.Получить("x-api-key");
    Если ПустаяСтрока(Заголовок) ИЛИ Заголовок <> ОжидаемыйКлюч Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Истина;
КонецФункции

Функция ЗаписьДанных(Запрос) Экспорт
    // POST /load
    Если НЕ ПроверитьКлюч(Запрос) Тогда
        Ответ401 = Новый HTTPСервисОтвет(401);
        Ответ401.УстановитьТелоИзСтроки("unauthorized",
            "text/plain; charset=utf-8");
        Возврат Ответ401;
    КонецЕсли;

    Тело = Запрос.ПолучитьТелоКакСтроку();
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Тело);
    Пакет = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();

    Создано = 0; Обновлено = 0; Ошибки = Новый Массив;
    Для Каждого Описание Из Пакет.objects Цикл
        ТипОбъекта = Описание.type;
        // Фаза 18: транзакция + обработка ошибки на каждый объект
        Попытка
            НачатьТранзакцию();
            ИмяСправочника = СтрЗаменить(ТипОбъекта, "Справочник.", "");
            Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
                ВызватьИсключение("Не найден объект: " + ТипОбъекта);
            КонецЕсли;
            Объект = Справочники[ИмяСправочника].СоздатьОбъект();
            Для Каждого КВ Из Описание.attributes Цикл
                // Имя реквизита приходит из тела запроса; используем только
                // существующие реквизиты справочника (идемпоцентно).
                ИмяРеквизита = Строка(КВ.Ключ);
                // Проверяем, что реквизит существует в метаданных — защита от
                // произвольных имён из запроса.
                Если Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти(ИмяРеквизита) = Неопределено
                    И НЕ ИмяРеквизита = "Наименование" Тогда
                    ВызватьИсключение("Нет реквизита: " + ИмяРеквизита);
                КонецЕсли;
                Объект[ИмяРеквизита] = КВ.Значение;
            КонецЦикла;
            Объект.Записать();
            ЗафиксироватьТранзакцию();
            Создано = Создано + 1;
        Исключение
            Если ТранзакцияАктивна() Тогда
                ОтменитьТранзакцию();
            КонецЕсли;
            ОписаниеОшибки = ОписаниеОшибки();
            Ошибки.Добавить(ТипОбъекта + ": " + ОписаниеОшибки);
        КонецПопытки;
    КонецЦикла;

    Ответ = Новый HTTPСервисОтвет(200);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись,
        Новый Структура("ok,created,updated,errors", Истина, Создано, Обновлено, Ошибки));
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции

Функция МетаданныеИБ(Запрос) Экспорт
    // GET /metadata — описание структуры приёмника
    Если НЕ ПроверитьКлюч(Запрос) Тогда
        Ответ401 = Новый HTTPСервисОтвет(401);
        Ответ401.УстановитьТелоИзСтроки("unauthorized",
            "text/plain; charset=utf-8");
        Возврат Ответ401;
    КонецЕсли;

    Справочники = Новый Массив;
    Для Каждого Спр Из Метаданные.Справочники Цикл
        Реквизиты = Новый Массив;
        Для Каждого Рек Из Спр.Реквизиты Цикл
            Реквизиты.Добавить(Новый Структура("Имя,Тип", Рек.Имя, Строка(Рек.Тип)));
        КонецЦикла;
        Справочники.Добавить(Новый Структура("Имя,Синоним,Реквизиты", Спр.Имя, Спр.Синоним, Реквизиты));
    КонецЦикла;
    Ответ = Новый HTTPСервисОтвет(200);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Новый Структура("Справочники", Справочники));
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции
