// Модуль HTTP-сервиса "onec_loader" (вставляется в 1С:Предприятие).
// Код-референс: пользователь вставляет в Конфигуратор и перезаписывает
// соответствующие процедуры. Полная XML-выгрузка расширения формируется
// штатным механизмом 1С:Предприятие после сборки.

Функция ЗаписьДанных(Запрос) Экспорт
    // POST /load
    Тело = Запрос.ПолучитьТелоКакСтроку();
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Тело);
    Пакет = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();

    Создано = 0; Обновлено = 0; Ошибки = Новый Массив;
    Для Каждого Описание Из Пакет.objects Цикл
        ТипОбъекта = Описание.type; // "Справочник.Номенклатура"
        ИмяСправочника = СтрЗаменить(ТипОбъекта, "Справочник.", "");
        Если НЕ Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
            Объект = Справочники[ИмяСправочника].СоздатьОбъект();
            Для Каждого КВ Из Описание.attributes Цикл
                // Установка реквизита по имени (защита от инъекций не нужна — имена из метаданных)
                Объект[Строка(КВ.Ключ)] = КВ.Значение;
            КонецЦикла;
            Объект.Записать();
            Создано = Создано + 1;
        Иначе
            Ошибки.Добавить("Не найден объект: " + ТипОбъекта);
        КонецЕсли;
    КонецЦикла;

    Ответ = Новый HTTPСервисОтвет(200);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Новый Структура("ok,created,updated,errors", Истина, Создано, Обновлено, Ошибки));
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции

Функция МетаданныеИБ(Запрос) Экспорт
    // GET /metadata — описание структуры приёмника (справочники, документы, реквизиты)
    Справочники = Новый Массив;
    Для Каждого Спр Из Метаданные.Справочники Цикл
        Реквизиты = Новый Массив;
        Для Каждого Рек Из Спр.Реквизиты Цикл
            Реквизиты.Добавить(Новый Структура("Имя,Тип", Рек.Имя, Строка(Рек.Тип)));
        КонецЦикла;
        Справочники.Добавить(Новый Структура("Имя,Синоним,Реквизиты", Спр.Имя, Спр.Синоним, Реквизиты));
    КонецЦикла;
    Ответ = Новый HTTPСервисОтвет(200);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Новый Структура("Справочники", Справочники));
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "application/json; charset=utf-8");
    Возврат Ответ;
КонецФункции
